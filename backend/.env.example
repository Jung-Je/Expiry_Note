# Copy this file to .env and adjust values for your local setup.
# .env is gitignored and must never be committed.

DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase project settings > Database > Connection string > URI.
# Use the "Session pooler" connection (not "Direct connection") — Django
# keeps long-lived connections and the pooler works over both IPv4 and IPv6.
# Append ?sslmode=require if it isn't already in the string Supabase gives you.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:your-db-password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase project settings > API.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Bypasses Row Level Security — backend-only, never ship this to a client app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
