# Local development defaults. Safe to commit — no real secrets, just the
# values that make `runserver` work against the local docker-compose db.
#
# Loaded by default (see config/settings.py). To try prod-like config
# locally, create .envs/.env.prod (gitignored) and run with
# DJANGO_ENV_FILE=.env.prod. A real deployment should set real environment
# variables directly instead of relying on either file.

DJANGO_SECRET_KEY=django-insecure-dev-only-not-for-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Matches the default `db` service in the root docker-compose.yml.
DATABASE_URL=postgres://expiry_note:expiry_note@localhost:5433/expiry_note

# Web frontend origin(s) allowed to call this API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Base URL of the web frontend, used to build links inside emails.
FRONTEND_URL=http://localhost:5173

# Prints emails to the runserver console instead of actually sending them.
# Switch to an SMTP backend once a real email provider is chosen.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@expirynote.local
