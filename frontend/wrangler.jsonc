{
  // Cloudflare Workers의 정적 자산(Static Assets) 배포 설정. `npm run build`가
  // 만든 ./dist를 그대로 서빙한다. react-router-dom으로 클라이언트 사이드
  // 라우팅을 쓰므로(/settings 등을 새로고침하면 서버엔 그 경로가 없음),
  // not_found_handling을 SPA 모드로 켜서 index.html로 폴백하게 한다.
  "name": "expiry-note",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // PR 미리보기 배포(Preview command: npx wrangler preview)에 필요 —
  // 비어있어도 이 블록 자체가 있어야 wrangler preview가 동작한다. 실제
  // main 배포는 이 블록과 무관한 npx wrangler deploy를 쓴다.
  "previews": {}
}
