# --- Python / Django (backend/) ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
db.sqlite3
staticfiles/
media/
.pytest_cache/
.ruff_cache/

# --- Env files ---
# Only .envs/.env.dev is committed (safe local defaults); everything else
# (.envs/.env.prod, or a stray .env/.env.local outside .envs/) stays local.
.env
.env.*
!**/.envs/.env.dev

# --- Node / frontend (frontend/) ---
node_modules/
dist/
build/
.next/
.expo/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store

# --- uv ---
uv.lock.bak
